{
  "name": "go-crypto-wallet",
  "image": "mcr.microsoft.com/devcontainers/go:1.25",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "bash -c 'go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.7.2 && curl -sSfL https://atlasgo.sh | sh -s -- --version v1.0.0'",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "DavidAnson.vscode-markdownlint",
        "yzhang.markdown-all-in-one",
        "timonwong.shellcheck",
        "foxundermoon.shell-format",
        "redhat.vscode-yaml",
        "tamasfe.even-better-toml",
        "ZainChen.json",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-mysql",
        "IBM.output-colorizer",
        "emilast.LogFileHighlighter",
        "zxh404.vscode-proto3",
        "hashicorp.hcl",
        "JuanBlanco.solidity",
        "EditorConfig.EditorConfig",
        "streetsidesoftware.code-spell-checker",
        "ms-azuretools.vscode-docker",
        "eamodio.gitlens"
      ],
      "settings": {
        "go.buildTags": "integration",
        "go.lintFlags": ["-tags=integration"],
        "go.lintTool": "golangci-lint",
        "go.lintOnSave": "package",
        "gopls": {
          "buildFlags": ["-tags=integration"]
        }
      }
    }
  },
  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ],
  "remoteUser": "vscode"
}
