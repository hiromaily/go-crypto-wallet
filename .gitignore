.DS_Store
.idea/

# temporary documents
docs/issues/*
!docs/issues/CURRENT_ISSUES.md
!docs/issues/REFACTORING_CHECKLIST.md
!docs/issues/REFACTORING_PLAN.md

# environment variables
.env

bin/

# built binaries (root only)
/keygen
/sign
/sign1
/sign2
/watch

# data directory
data/address/*
data/certs/*
data/descriptor/*
data/dump/*
data/fullpubkey/*
data/keystore/*
data/tx/*
data/gaiad/*

# Node files
# BTC
docker/nodes/btc/watch/*
!docker/nodes/btc/watch/bitcoin.conf
docker/nodes/btc/keygen/*
!docker/nodes/btc/keygen/bitcoin.conf
docker/nodes/btc/sign1/*
!docker/nodes/btc/sign1/bitcoin.conf
docker/nodes/btc/sign2/*
!docker/nodes/btc/sign2/bitcoin.conf
# BCH
docker/nodes/bch/watch/*
!docker/nodes/bch/watch/bitcoin.conf
docker/nodes/bch/keygen/*
!docker/nodes/bch/keygen/bitcoin.conf
docker/nodes/bch/sign1/*
!docker/nodes/bch/sign1/bitcoin.conf
docker/nodes/bch/sign2/*
!docker/nodes/bch/sign2/bitcoin.conf
# ETH
docker/nodes/eth/goerli/*
docker/nodes/eth/sepolia/*
docker/nodes/eth/ganache-data/*
docker/nodes/eth/backup/exported-file
# XRP
docker/nodes/xrp/db/*

!.gitkeep
