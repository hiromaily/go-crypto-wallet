data/certs/*
data/db/*
data/descriptor/*
data/dump/*
data/fullpubkey/*
data/keystore/*
data/logs/*
data/tx/*
data/gaiad/*
data/sqlite/**/*.db
data/sqlite/**/*.db-wal
data/sqlite/**/*.db-shm

